# Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit .env - it should only exist locally

# Project Information
PROJECT_NAME=""
PROJECT_REPOSITORY=""

# Application
NODE_ENV=development
# Please keep ports above 9000 to avoid conflicts with system services
PORT=9000

# oidc-auth-server secrets (environment-owned; see oidc-auth-server.config.env-keys
# in config/app-default-config.json). Never put these in a config file.
# A JSON Web Key Set holding private signing keys, as one line of JSON:
OIDC_AUTH_SERVER_JWKS=
# Cookie signing keys, comma-separated, each at least 32 characters:
OIDC_AUTH_SERVER_COOKIE_KEYS=

# Add your environment variables below
# DATABASE_URL=
# API_KEY=
# JWT_SECRET=
